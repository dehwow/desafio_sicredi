# Variáveis de ambiente para desenvolvimento local
# Copie este arquivo para ".env" e ajuste os valores se necessário.

# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qrcode_inventory
POSTGRES_PORT=5432

# Hosts dos serviços vistos pelo aplicativo
# - Rodando a aplicação na sua máquina: use localhost
# - Rodando a aplicação em container no mesmo compose: use o nome do serviço ("postgres" ou "redis")
DB_HOST=localhost

# Aplicação
SERVER_PORT=8080
